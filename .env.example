# ──────────────────────────────────────────────────────────────
# Переменные бэкенда и ETL. Скопируйте этот файл в .env и заполните.
# Файл .env в git не попадает.
# ──────────────────────────────────────────────────────────────

# ── Postgres (суперпользователь, нужен только docker-compose) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres

# ── Рабочая база платформы (используют api/, etl/, airflow) ──
# При нативном запуске без Docker ONEC_DB_HOST=127.0.0.1
ONEC_DB_HOST=postgres
ONEC_DB_PORT=5432
ONEC_DB_NAME=onec
ONEC_DB_USER=onec
ONEC_DB_PASSWORD=changeme

# ── Airflow (нужен только если запускаете docker-compose с Airflow) ──
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_UID=50000

# ── 1С OData ──
# Адрес стандартного интерфейса OData вашей базы 1С.
# Обычно выглядит как https://<сервер>/<имя_базы>/odata/standard.odata
ONEC_ODATA_URL=https://odata.example.com/demo_ut/odata/standard.odata
# Пользователь 1С с правами на чтение нужных объектов (список в README).
ONEC_ODATA_USER=demo_user
ONEC_ODATA_PASSWORD=change-me
# Часовой пояс, в котором 1С отдаёт даты документов.
ONEC_TIMEZONE=Asia/Almaty

# ── FastAPI (api/) ──
# Разрешённые origin для CORS. `*` пропускает всех. На проде лучше
# указать домен фронта.
ALLOWED_ORIGINS=*
# Защита API: если задан, все эндпоинты кроме /health требуют заголовок X-API-Key.
# Должен совпадать с API_KEY в .env.local фронта. Сгенерировать: openssl rand -hex 32
API_KEY=

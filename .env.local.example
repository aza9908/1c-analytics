# ──────────────────────────────────────────────────────────────
# Переменные фронта (Next.js). Скопируйте этот файл в .env.local
# и поправьте значения под себя. Файл .env.local в git не попадает.
# ──────────────────────────────────────────────────────────────

# Адрес FastAPI-бэкенда, доступный из браузера.
# Локально: http://localhost:8000. На проде: публичный домен API.
# Переменные с префиксом NEXT_PUBLIC_ попадают в клиентский бандл.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Адрес того же бэкенда для серверной части Next.js (route handlers app/api/*).
# Может отличаться от публичного, например внутренний адрес в сети сервера.
# Если не задан, маршруты /api/* отвечают 503.
API_URL=http://localhost:8000

# Общий секрет между Next.js и FastAPI (опционально).
# Если задан, Next.js добавляет заголовок X-API-Key, а FastAPI его проверяет.
# Должен совпадать с API_KEY в .env бэкенда. Сгенерировать: openssl rand -hex 32
API_KEY=

# Логин и пароль для входа в дашборды (см. lib/auth.ts).
# По умолчанию admin / admin. На проде обязательно замените.
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=admin

# Ключ для подписи cookie сессии. На проде сгенерируйте: openssl rand -hex 32
AUTH_SECRET=change-me-to-random-string

# Раскомментируйте, чтобы отключить авторизацию (только для разработки).
# BASIC_AUTH_DISABLED=1

# Раскомментируйте на проде за HTTPS, чтобы cookie ставилась с флагом Secure.
# AUTH_COOKIE_SECURE=1
